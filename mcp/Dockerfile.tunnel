FROM ghcr.io/openai/tunnel-client:v0.0.11 AS tunnel

FROM node:22-alpine

RUN apk add --no-cache ca-certificates
WORKDIR /app

COPY --from=tunnel /usr/bin/tunnel-client /usr/local/bin/tunnel-client
COPY --from=tunnel /usr/bin/cloudflared /usr/local/bin/cloudflared

COPY package.json ./
RUN npm install --omit=dev --ignore-scripts

COPY mcp/package.json ./mcp/package.json
RUN npm --prefix mcp install --omit=dev

COPY . .

ENV MCP_COMMAND="node /app/mcp/server.mjs" \
    LOG_LEVEL="info" \
    LOG_FORMAT="json" \
    HEALTH_LISTEN_ADDR=":8080"

EXPOSE 8080
ENTRYPOINT ["tunnel-client", "run"]
